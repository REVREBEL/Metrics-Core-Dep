{
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/registry": [
        "./registry.json"
      ],
      "@auto-form": [
        "./src/primitives/auto-form/index.ts"
      ],
      "@buttons": [
        "./src/primitives/buttons/index.ts"
      ],
      "@charts": [
        "./src/primitives/charts/index.ts"
      ],
      "@primitive-charts": [
        "./src/primitives/charts/index.ts"
      ],
      "@dropdowns": [
        "./src/primitives/dropdowns/index.ts"
      ],
      "@inputs": [
        "./src/primitives/inputs/index.ts"
      ],
      "@primitive-layouts": [
        "./src/primitives/layouts/index.ts"
      ],
      "@layouts": [
        "./src/primitives/layouts/index.ts"
      ],
      "@menus": [
        "./src/primitives/menus/index.ts"
      ],
      "@popovers": [
        "./src/primitives/popovers/index.ts"
      ],
      "@primitive-registry": [
        "./src/primitives/registry/index.ts"
      ],
      "@skeleton": [
        "./src/primitives/skeleton/index.ts"
      ],
      "@primitive-tables": [
        "./src/primitives/tables/index.ts"
      ],
      "@tabs": [
        "./src/primitives/tabs/index.ts"
      ],
      "@tables": [
        "./src/primitives/tables/index.ts"
      ],
      "@textarea": [
        "./src/primitives/textarea/index.ts"
      ],
      "@typography": [
        "./src/primitives/typography/index.ts"
      ],
      "@ui": [
        "./src/primitives/ui/index.ts"
      ],
      "@studio-blocks": [
        "./src/primitives/studio-blocks/index.ts"
      ],
      "@shared-props": [
        "./src/components/_shared-props/index.ts"
      ],
      "@shared-ui": [
        "./src/components/_shared-ui/index.ts"
      ],
      "@metrics-charts": [
        "./src/components/metrics-charts/index.ts"
      ],
      "@metrics-errors": [
        "./src/components/metrics-errors/index.ts"
      ],
      "@metrics-feedback": [
        "./src/components/metrics-feedback/index.ts"
      ],
      "@metrics-layouts": [
        "./src/components/metrics-layouts/index.ts"
      ],
      "@metrics-core": [
        "./src/components/metrics-core/index.ts"
      ],
      "@metrics-sections": [
        "./src/components/metrics-sections/index.ts"
      ],
      "@metrics-tables": [
        "./src/components/metrics-tables/index.ts"
      ],
      "@metrics-timeline": [
        "./src/components/metrics-timeline/index.ts"
      ],
      "@common": [
        "./src/common/index.ts"
      ],
      "@context": [
        "./src/context/index.ts"
      ],
      "@db": [
        "./src/db/index.ts"
      ],
      "@fonts": [
        "./src/fonts/index.ts"
      ],
      "@hooks": [
        "./src/hooks/index.ts"
      ],
      "@icons": [
        "./src/icons/index.ts"
      ],
      "@lib": [
        "./src/lib/index.ts"
      ],
      "@styles": [
        "./src/styles/index.ts"
      ],
      "@types": [
        "./src/types/index.ts"
      ],
      "@utils": [
        "./src/utils/index.ts"
      ],
      "@data-grid": [
        "./src/primitives/data-grid/index.ts"
      ],
      "@image-blocks": [
        "./src/primitives/image-blocks/index.ts"
      ],
      "@links": [
        "./src/primitives/links/index.ts"
      ],
      "@lists": [
        "./src/primitives/lists/index.ts"
      ]
    },
    "plugins": [
      {
        "name": "next"
      }
    ],
    "target": "ES2017"
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "next-env.d.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
