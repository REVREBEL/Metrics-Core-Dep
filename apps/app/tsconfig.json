{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "incremental": true,
    "module": "esnext",
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@repo/ui": ["../../packages/ui/src/index.ts"],
      "@repo/ui/*": ["../../packages/ui/src/*"],
      "@/*": ["../../packages/ui/src/*"],
      "@/primitives/*": ["../../packages/ui/src/primitives/*"],
      "@ui": ["../../packages/ui/src/primitives/ui-core/index.ts"],
      "@ui/*": ["../../packages/ui/src/primitives/ui-core/*"],
      "@auto-form": ["../../packages/ui/src/primitives/forms/index.ts"],
      "@auto-form/*": ["../../packages/ui/src/primitives/forms/*"],
      "@buttons": ["../../packages/ui/src/primitives/buttons/index.ts"],
      "@buttons/*": ["../../packages/ui/src/primitives/buttons/*"],
      "@charts": ["../../packages/ui/src/primitives/charts/index.ts"],
      "@primitive-charts": ["../../packages/ui/src/primitives/charts/index.ts"],
      "@dropdown": ["../../packages/ui/src/primitives/dropdowns/index.ts"],
      "@dropdown/*": ["../../packages/ui/src/primitives/dropdowns/*"],
      "@dropdowns": ["../../packages/ui/src/primitives/dropdowns/index.ts"],
      "@dropdowns/*": ["../../packages/ui/src/primitives/dropdowns/*"],
      "@inputs": ["../../packages/ui/src/primitives/inputs/index.ts"],
      "@inputs/*": ["../../packages/ui/src/primitives/inputs/*"],
      "@primitive-layouts": ["../../packages/ui/src/primitives/layouts/index.ts"],
      "@layouts": ["../../packages/ui/src/primitives/layouts/index.ts"],
      "@menus": ["../../packages/ui/src/primitives/menus/index.ts"],
      "@popovers": ["../../packages/ui/src/primitives/popovers/index.ts"],
      "@popovers/*": ["../../packages/ui/src/primitives/popovers/*"],
      "@primitive-registry": ["../../packages/ui/src/primitives/registry/index.ts"],
      "@skeleton": ["../../packages/ui/src/primitives/skeleton/index.ts"],
      "@primitive-tables": ["../../packages/ui/src/primitives/tables/index.ts"],
      "@tabs": ["../../packages/ui/src/primitives/tabs/index.ts"],
      "@tables": ["../../packages/ui/src/primitives/tables/index.ts"],
      "@tables/*": ["../../packages/ui/src/primitives/tables/*"],
      "@textarea": ["../../packages/ui/src/primitives/textarea/index.ts"],
      "@textarea/*": ["../../packages/ui/src/primitives/textarea/*"],
      "@typography": ["../../packages/ui/src/primitives/typography/index.ts"],
      "@studio-blocks": ["../../packages/ui/src/primitives/studio-blocks/index.ts"],
      "@shared-props": ["../../packages/ui/src/components/_shared-props/index.ts"],
      "@shared-ui": ["../../packages/ui/src/components/_shared-ui/index.ts"],
      "@metrics-charts": ["../../packages/ui/src/components/metrics-charts/index.ts"],
      "@metrics-errors": ["../../packages/ui/src/components/metrics-errors/index.ts"],
      "@metrics-feedback": ["../../packages/ui/src/components/metrics-feedback/index.ts"],
      "@metrics-layouts": ["../../packages/ui/src/components/metrics-layouts/index.ts"],
      "@metrics-core": ["../../packages/ui/src/components/metrics-core/index.ts"],
      "@metrics-sections": ["../../packages/ui/src/components/metrics-sections/index.ts"],
      "@metrics-tables": ["../../packages/ui/src/components/metrics-tables/index.ts"],
      "@metrics-timeline": ["../../packages/ui/src/components/metrics-timeline/index.ts"],
      "@common": ["../../packages/ui/src/common/index.ts"],
      "@context": ["../../packages/ui/src/context/index.ts"],
      "@db": ["../../packages/ui/src/db/index.ts"],
      "@fonts": ["../../packages/ui/src/fonts/index.ts"],
      "@hooks": ["../../packages/ui/src/hooks/index.ts"],
      "@icons": ["../../packages/ui/src/icons/index.ts"],
      "@lib": ["../../packages/ui/src/lib/index.ts"],
      "@styles": ["../../packages/ui/src/styles/index.ts"],
      "@types": ["../../packages/ui/src/types/index.ts"],
      "@utils": ["../../packages/ui/src/utils/index.ts"],
      "@data-grid": ["../../packages/ui/src/primitives/data-grid/index.ts"],
      "@image-blocks": ["../../packages/ui/src/primitives/image-blocks/index.ts"],
      "@links": ["../../packages/ui/src/primitives/links/index.ts"],
      "@lists": ["../../packages/ui/src/primitives/lists/index.ts"]
    }
  },
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
